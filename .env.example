# Application
APP_ENV=development
APP_NAME=reg_engine
APP_SECRET_KEY=change-me

# API
API_V1_PREFIX=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=60

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=reg_engine
POSTGRES_USER=reg_engine_admin
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://reg_engine_admin:change-me@localhost:5432/reg_engine

# Runtime
LOG_LEVEL=INFO

# Optional local check helper
REG_ENGINE_PGPASSWORD=change-me
